+# The id `peer` knows each subject of `snapshot` by (-1 if none yet)
+func _ids_known_by(peer: int, snapshot: _Snapshot) -> PackedInt64Array:
+	var ids := PackedInt64Array()
+	for subject in snapshot.get_subjects():
+		var identifier := _identity_server._get_identifier_of(subject)
+		ids.append(identifier.get_id_for(peer) if identifier else -2)
+	return ids
+
+# True if no visibility filter hides a state node from any of `peers`
+func _everyone_sees_everything(peers: PackedInt32Array) -> bool:
+	for subject in _rb_owned_state_properties.get_subjects():
+		var filter := _visibility_filters.get(subject) as PeerVisibilityFilter
+		if not filter:
+			continue
+		var visible := filter.get_visible_peers()
+		for peer in peers:
+			if not visible.has(peer):
+				return false
+	return true
 
