class_name Gear
extends RefCounted
## Who wears what (PLAN §3.2): players are rangers, the training squires peasants, the dead
## peasants in their dark set with grey skin and ember eyes (Quaternius outfits and base
## character heads, CC0), the Warden the UAL figure in black iron. Weapons and shields are
## generated by `Generators` (M39) from an item's `look` and `look_params`.
## Every prop's origin is the grip, its long axis local +Y (the hand bone's axis toward the
## fingers).

const REALM := "barrowlands"
## Shields hang from the forearm, face turned outward.
const SHIELD_LOOKS: Array[StringName] = [&"round_shield", &"kite_shield", &"tower_shield"]
## Enemy eyes and shots.
const EMBER := Color(1.0, 0.35, 0.1)
const STEEL := Color(0.62, 0.63, 0.65)
const IRON := Color(0.16, 0.16, 0.17)
const LEATHER := Color(0.2, 0.14, 0.1)
## The dead's skin and faded clothes.
const DEAD := Color(0.72, 0.78, 0.68)
## The berserker's skin under its war paint.
const PAINT := Color(0.75, 0.5, 0.45)


## A knight: plate for the body, leather at the joints (the mannequin's second surface).
static func armor(plate := STEEL, joints := LEATHER) -> Array[Material]:
	# Half metal: full metal mirrors the black night sky and goes black.
	var plates := _metal(plate, 0.45)
	plates.metallic = 0.45
	var leather := StandardMaterial3D.new()
	leather.albedo_color = joints
	leather.roughness = 0.85
	return [plates, leather]


## A player: a ranger, male (bearded) or female in the second color set by peer id, with a dark
## or light skin by the next bit.
static func ranger(peer_id: int, held: Dictionary) -> CharacterModel:
	var male := peer_id % 2 == 0
	var light := (peer_id / 2) % 2 == 1
	var c := CharacterModel.CHARACTERS
	var outfit := CharacterModel.RANGER_MALE if male else CharacterModel.RANGER_FEMALE
	var model := CharacterModel.new(outfit, held)
	if male:
		model.wear_head(
			CharacterModel.BODY_MALE,
			[c + "Hair_Beard.gltf"],
			load(c + "T_Superhero_Male_Ligh.png") if light else null
		)
	else:
		model.wear_head(
			CharacterModel.BODY_FEMALE,
			[],
			load(c + "T_Superhero_Female_Light_BaseColor.png") if light else null
		)
		model.swap_albedo(
			"T_Ranger_BaseColor.png", load(CharacterModel.OUTFITS + "T_Ranger_3_BaseColor.png")
		)
	return model


## A training squire: a peasant with short or parted hair.
static func squire(index: int, held: Dictionary) -> CharacterModel:
	var c := CharacterModel.CHARACTERS
	var model := CharacterModel.new(CharacterModel.PEASANT_MALE, held)
	var hair := "Hair_SimpleParted.gltf" if index % 2 == 0 else "Hair_Buzzed.gltf"
	model.wear_head(CharacterModel.BODY_MALE, [c + hair], load(c + "T_Superhero_Male_Ligh.png"))
	return model


## One of the dead: a peasant in the dark set, grey-green, long or bound hair, ember eyes (male
## swordsmen, female crossbow archers).
static func dead(archer: bool, held: Dictionary) -> CharacterModel:
	var c := CharacterModel.CHARACTERS
	held["eyes"] = ["Head", eyes()]
	var outfit := CharacterModel.PEASANT_FEMALE if archer else CharacterModel.PEASANT_MALE
	var model := CharacterModel.new(outfit, held)
	if archer:
		model.wear_head(CharacterModel.BODY_FEMALE, [c + "Hair_Buns.gltf"])
	else:
		model.wear_head(CharacterModel.BODY_MALE, [c + "Hair_Long.gltf"])
	model.swap_albedo(
		"T_Peasant_BaseColor.png", load(CharacterModel.OUTFITS + "T_Peasant_2_BaseColor.png")
	)
	model.tint(DEAD)
	return model


## A shield bearer: one of the dead in a dark set, shield up (the helm and shield are held).
static func bearer(held: Dictionary) -> CharacterModel:
	held["helm"] = ["Head", helm({"role": "iron", "wear": 0.5})]
	held["shield"] = ["LeftLowerArm", tower_shield()]
	return dead(false, held)


## A berserker: the bare male body (no outfit), bearded, skin gone grey and daubed with war
## paint, a rust red tint; the axes are held.
static func berserker(held: Dictionary) -> CharacterModel:
	var c := CharacterModel.CHARACTERS
	held["eyes"] = ["Head", eyes(EMBER, 9.0)]
	var model := CharacterModel.new(CharacterModel.BODY_MALE, held)
	model.tint(PAINT)
	return model


## A rounded bascinet for the head bone.
static func helm(params := {}) -> Node3D:
	return make(&"helm", params)


## Two horns curving up and out of a helm, for the head bone.
static func horns(params := {}) -> Node3D:
	return make(&"horns", params)


## A crown of iron spikes around the helm, for the head bone.
static func crown(params := {}) -> Node3D:
	return make(&"crown", params)


## A tattered cape hanging from the shoulders, for the upper chest bone.
static func cape(params := {}) -> Node3D:
	return make(&"cape", params)


## Spiked pauldrons on both shoulders, for the upper chest bone.
static func pauldrons(params := {}) -> Node3D:
	return make(&"pauldrons", params)


## Two ember eyes, for the head bone of the dead.
static func eyes(color := EMBER, energy := 6.0) -> Node3D:
	var root := Node3D.new()
	for x: float in [-0.035, 0.035]:
		var eye := MeshInstance3D.new()
		var ball := SphereMesh.new()
		ball.radius = 0.016
		ball.height = 0.032
		ball.material = _glow(color, energy)
		eye.mesh = ball
		eye.position = Vector3(x, 0.09, 0.09)
		eye.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		root.add_child(eye)
	return root


## A generated model of `look` with `params`, as one mesh node (hand gear: origin at the grip, long
## axis +Y; shields come in a holder that turns the face outward from the forearm).
static func make(look: StringName, params := {}, variant_seed := 1) -> Node3D:
	var meshes := Generators.build(String(look), variant_seed, Palette.of(REALM), params)
	var node := MeshInstance3D.new()
	node.mesh = meshes[0]
	if not SHIELD_LOOKS.has(look):
		return node
	var holder := Node3D.new()
	holder.add_child(node)
	holder.rotation = Vector3(0, PI / 2.0, 0)
	holder.position = Vector3(float(params.get("hold", 0.08)), 0.0, 0.0)
	return holder


## The item's own look (hand gear or armor).
static func of_item(def: ItemDef) -> Node3D:
	return make(def.look, def.look_params)


## A straight double edged sword; rust for the dead's (`params.role = "rot"`, `wear`).
static func sword(params := {}) -> Node3D:
	return make(&"sword", params)


## The round wooden shield.
static func shield() -> Node3D:
	return make(&"round_shield")


## A tower shield: tall planks bound in iron with a boss.
static func tower_shield() -> Node3D:
	return make(&"tower_shield", {"hold": 0.1})


static func axe(params := {}) -> Node3D:
	return make(&"axe", params)


static func crossbow(params := {}) -> Node3D:
	return make(&"crossbow", params)


static func _metal(color: Color, roughness: float) -> StandardMaterial3D:
	var material := StandardMaterial3D.new()
	material.albedo_color = color
	material.metallic = 0.85
	material.roughness = roughness
	return material


static func _glow(color: Color, energy: float) -> StandardMaterial3D:
	var material := StandardMaterial3D.new()
	material.albedo_color = color.darkened(0.5)
	material.emission_enabled = true
	material.emission = color
	material.emission_energy_multiplier = energy
	return material
