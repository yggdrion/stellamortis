class_name Gear
extends RefCounted
## Who wears what (PLAN §3.2): players are one of four generated bodies (M40), the training squires
## plain men, the dead rotten flesh in their dark set with ember eyes, the Warden the heavy body in
## black iron. Weapons and shields are
## generated by `Generators` (M39) from an item's `look` and `look_params`.
## Every prop's origin is the grip, its long axis local +Y (the hand bone's axis toward the
## fingers).

const REALM := "barrowlands"
## Shields hang from the forearm, face turned outward.
const SHIELD_LOOKS: Array[StringName] = [&"round_shield", &"kite_shield", &"tower_shield"]
## Enemy eyes and shots.
const EMBER := Color(1.0, 0.35, 0.1)
const IRON := Color(0.16, 0.16, 0.17)
## The player bodies (male A, male B, female A, female B), skin and hair colors.
const PLAYER_BODIES: Array[StringName] = [&"male_a", &"male_b", &"female_a", &"female_b"]
const SKINS: Array[StringName] = [&"skin_a", &"skin_b", &"skin_c", &"skin_d"]
const HAIRS: Array[StringName] = [&"hair_a", &"hair_b", &"hair_c", &"hair_d"]
## The berserker's skin under its war paint.
const PAINT := Color(0.75, 0.5, 0.45)


## A player: one of four bodies, the one picked (`pick` 0 to 3) or by peer id (-1: bots, tests),
## in the skin and hair colors the next bits of the peer id pick.
static func ranger(peer_id: int, held: Dictionary, pick := -1) -> CharacterModel:
	var body: String = PLAYER_BODIES[pick if pick >= 0 else peer_id % 4]
	var look := {
		"skin": SKINS[(peer_id / 4) % SKINS.size()], "hair": HAIRS[(peer_id / 16) % HAIRS.size()]
	}
	return CharacterModel.new(CharacterModel.body_path(body), held, 1.0, look)


## A training squire: a man in the plain tunic, a lean one or a stocky one.
static func squire(index: int, held: Dictionary) -> CharacterModel:
	var body := &"male_a" if index % 2 == 0 else &"male_b"
	var look := {"skin": &"skin_a", "hair": HAIRS[index % HAIRS.size()]}
	return CharacterModel.new(CharacterModel.body_path(body), held, 1.0, look)


## One of the dead: rotten flesh in the dark set, ember eyes (female crossbow archers, male
## swordsmen, every third one a skull jaw by its index).
static func dead(archer: bool, held: Dictionary, index := 0) -> CharacterModel:
	held["eyes"] = ["Head", eyes()]
	var body := &"dead_female" if archer else &"dead_male"
	if not archer and index % 3 == 2:
		body = &"dead_skull"
	return CharacterModel.new(CharacterModel.body_path(body), held, 1.0, {"hair": &"hair_d"})


## A shield bearer: one of the dead, shield up (the helm and shield are held).
static func bearer(held: Dictionary, index := 0) -> CharacterModel:
	held["helm"] = ["Head", helm({"role": "iron", "wear": 0.5})]
	held["shield"] = ["LeftLowerArm", tower_shield()]
	return dead(false, held, index)


## A berserker: the bare heavy body, bearded, skin gone grey and daubed with war paint; the axes
## are held.
static func berserker(held: Dictionary) -> CharacterModel:
	held["eyes"] = ["Head", eyes(EMBER, 9.0)]
	var look := {"skin": PAINT, "hair": &"hair_a", "roles": {&"belt": &"leather"}}
	return CharacterModel.new(CharacterModel.body_path(&"berserker"), held, 1.0, look)


## The Warden and the barrow elites: the heavy body in black iron plate (the bands the body
## colors as `belt`), at height / SimPlayer.HEIGHT times the size.
static func armored(held: Dictionary, scale_by: float, plate := IRON) -> CharacterModel:
	var look := {"skin": &"skin_d", "roles": {&"belt": plate, &"tunic": plate, &"sleeve": plate}}
	return CharacterModel.new(CharacterModel.body_path(&"warden"), held, scale_by, look)


## A rounded bascinet for the head bone.
static func helm(params := {}) -> Node3D:
	return make(&"helm", params)


## Two horns curving up and out of a helm, for the head bone.
static func horns(params := {}) -> Node3D:
	return make(&"horns", params)


## A crown of iron spikes around the helm, for the head bone.
static func crown(params := {}) -> Node3D:
	return make(&"crown", params)


## A tattered cape hanging from the shoulders, for the upper chest bone.
static func cape(params := {}) -> Node3D:
	return make(&"cape", params)


## Spiked pauldrons on both shoulders, for the upper chest bone.
static func pauldrons(params := {}) -> Node3D:
	return make(&"pauldrons", params)


## Two ember eyes, for the head bone of the dead.
static func eyes(color := EMBER, energy := 6.0) -> Node3D:
	var root := Node3D.new()
	for x: float in [-0.035, 0.035]:
		var eye := MeshInstance3D.new()
		var ball := SphereMesh.new()
		ball.radius = 0.016
		ball.height = 0.032
		ball.material = _glow(color, energy)
		eye.mesh = ball
		eye.position = Vector3(x, 0.09, 0.09)
		eye.cast_shadow = GeometryInstance3D.SHADOW_CASTING_SETTING_OFF
		root.add_child(eye)
	return root


## A generated model of `look` with `params`, as one mesh node (hand gear: origin at the grip, long
## axis +Y; shields come in a holder that turns the face outward from the forearm).
static func make(look: StringName, params := {}, variant_seed := 1) -> Node3D:
	var meshes := Generators.build(String(look), variant_seed, Palette.of(REALM), params)
	var node := MeshInstance3D.new()
	node.mesh = meshes[0]
	if not SHIELD_LOOKS.has(look):
		return node
	var holder := Node3D.new()
	holder.add_child(node)
	holder.rotation = Vector3(0, PI / 2.0, 0)
	holder.position = Vector3(float(params.get("hold", 0.08)), 0.0, 0.0)
	return holder


## The item's own look (hand gear or armor).
static func of_item(def: ItemDef) -> Node3D:
	return make(def.look, def.look_params)


## A straight double edged sword; rust for the dead's (`params.role = "rot"`, `wear`).
static func sword(params := {}) -> Node3D:
	return make(&"sword", params)


## The round wooden shield.
static func shield() -> Node3D:
	return make(&"round_shield")


## A tower shield: tall planks bound in iron with a boss.
static func tower_shield() -> Node3D:
	return make(&"tower_shield", {"hold": 0.1})


static func axe(params := {}) -> Node3D:
	return make(&"axe", params)


static func crossbow(params := {}) -> Node3D:
	return make(&"crossbow", params)


static func _glow(color: Color, energy: float) -> StandardMaterial3D:
	var material := StandardMaterial3D.new()
	material.albedo_color = color.darkened(0.5)
	material.emission_enabled = true
	material.emission = color
	material.emission_energy_multiplier = energy
	return material
